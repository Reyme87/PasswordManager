<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\eye-crossed.png" />
    <None Remove="Resources\eye.png" />
    <None Remove="Resources\Icon.png" />
    <None Remove="Resources\MasterCard.png" />
    <None Remove="Resources\MIR.png" />
    <None Remove="Resources\search.png" />
    <None Remove="Resources\Visa.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Extended.Wpf.Toolkit" Version="4.7.25104.5739" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Card.png" />
    <Resource Include="Resources\copy.png" />
    <Resource Include="Resources\eye-crossed.png" />
    <Resource Include="Resources\eye.png" />
    <Resource Include="Resources\Icon.png" />
    <Resource Include="Resources\MasterCard.png" />
    <Resource Include="Resources\MIR.png" />
    <Resource Include="Resources\search.png" />
    <Resource Include="Resources\Visa.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
