<Page x:Class="PasswordManager.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PasswordManager"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="600"
      Title="MainPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.7*"/>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="0.6*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.3*"/>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition Width="0.3*"/>
        </Grid.ColumnDefinitions>

        <Button Content="Passwords" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="10 10 10 0"/>
        <Button Content="Payment Methods" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="10 0"/>
        <Button Content="Notes" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="10 0 10 10"/>
    </Grid>
</Page>
