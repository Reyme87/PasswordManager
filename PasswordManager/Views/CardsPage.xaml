<Page x:Class="PasswordManager.Views.CardsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PasswordManager.Views"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="600" FontFamily="{StaticResource MainFont}"
      Title="CardsPage">

    <Page.Resources>
        <ResourceDictionary Source="ResourceDictionary.xaml"/>
    </Page.Resources>

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" FontSize="28" Foreground="{StaticResource ControlsColor}" Content="Your own payment manager"
       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="3" Margin="5" FontSize="18"/>

        <Button Style="{StaticResource BaseButtonStyle}" Content="Add" Grid.Row="4" Grid.Column="0" Margin="10" FontSize="20"/>
        <Button Style="{StaticResource BaseButtonStyle}" Content="Remove" Grid.Row="4" Grid.Column="1" Margin="10" FontSize="20"/>
        <Button Style="{StaticResource BaseButtonStyle}" Content="Save" Grid.Row="4" Grid.Column="2" Margin="10" FontSize="20"/>
        <Button Style="{StaticResource BaseButtonStyle}" Content="Import" Grid.Row="4" Grid.Column="3" Margin="10" Width="100" FontSize="20"
            HorizontalAlignment="Left"/>
        <Button Style="{StaticResource BaseButtonStyle}" Content="Export" Grid.Row="4" Grid.Column="3" Margin="10" Width="100" FontSize="20"
            HorizontalAlignment="Right"/>

        <Button Style="{StaticResource BaseButtonStyle}" Content="&lt;&lt;" Grid.Row="0" Grid.Column="0" Margin="10" FontSize="20" FontFamily="{StaticResource AdditiveFont}"
            HorizontalAlignment="Left" Width="50" Click="Button_Click"/>

        <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Grid.RowSpan="3" Margin="5">
            <StackPanel Margin="5">
                <Label Content="Card number: " FontSize="24" Foreground="{StaticResource ForeColor}" Padding="5" Margin="10 0"/>
                <DockPanel>
                    <Grid>
                        <TextBox Style="{StaticResource MainTextBox}" FontSize="22" MinWidth="280" MaxWidth="280" Margin="10 10 0 10" Padding="5" VerticalAlignment="Center" IsReadOnly="True"/>
                        <Button Style="{StaticResource AnimatedButtonStyle}" Command="{Binding RevealPasswordCommand}" Content="{StaticResource EyeImage1}" BorderThickness="0" Width="30" Height="30" HorizontalAlignment="Right" Margin="10"/>
                    </Grid>
                    <Button Command="{Binding CopyDataCommand}" CommandParameter="Username" Style="{StaticResource AnimatedCopyButtonStyle}" Content="{StaticResource CopyImage3}" BorderThickness="0" HorizontalAlignment="Right" Margin="5"/>
                </DockPanel>
            </StackPanel>

            <DockPanel>
                <StackPanel Margin="5 5 0 5">
                    <Label Content="MM/YY: " FontSize="24" Foreground="{StaticResource ForeColor}" Padding="5" Margin="10 0"/>
                    <DockPanel>
                        <Grid>
                            <TextBox Style="{StaticResource MainTextBox}" Text="12/20" FontSize="22" MinWidth="115" MaxWidth="115"  Margin="10 10 0 10" Padding="5" VerticalAlignment="Center" IsReadOnly="True"/>
                            <Button Style="{StaticResource AnimatedButtonStyle}" Command="{Binding RevealPasswordCommand}" Content="{StaticResource EyeImage2}" BorderThickness="0" Width="30" Height="30" HorizontalAlignment="Right" Margin="10"/>
                        </Grid>
                        <Button Command="{Binding CopyDataCommand}" CommandParameter="Username" Style="{StaticResource AnimatedCopyButtonStyle}" Content="{StaticResource CopyImage4}" BorderThickness="0" HorizontalAlignment="Right" Margin="5"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel Margin="5 5 0 5">
                    <Label Content="CVV/CVC: " FontSize="24" Foreground="{StaticResource ForeColor}" Padding="5" Margin="5 0 10 0"/>
                    <DockPanel>
                        <TextBox Style="{StaticResource MainTextBox}" Text="###" FontSize="22" MinWidth="115" MaxWidth="115" Margin="5 10 0 10" Padding="5" VerticalAlignment="Center" IsReadOnly="True"/>
                        <Button Command="{Binding CopyDataCommand}" CommandParameter="Username" Style="{StaticResource AnimatedCopyButtonStyle}" Content="{StaticResource CopyImage5}" BorderThickness="0" HorizontalAlignment="Right" Margin="5 5 7 5"/>
                    </DockPanel>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</Page>
