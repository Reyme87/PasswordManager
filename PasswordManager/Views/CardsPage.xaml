<Page x:Class="PasswordManager.Views.CardsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PasswordManager.Views"
      xmlns:vm="clr-namespace:PasswordManager.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="600" FontFamily="{StaticResource MainFont}"
      Title="CardsPage">
      
    <Page.DataContext>
        <vm:CardsViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <ResourceDictionary Source="ResourceDictionary.xaml"/>
    </Page.Resources>

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" FontSize="28" Foreground="{StaticResource ControlsColor}" Content="Your own payment manager"
       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <ListBox ItemsSource="{Binding Cards, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" SelectedItem="{Binding SelectedCard}" Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="3" Margin="5" FontSize="18">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Label Content="{Binding LastNumbers}" FontSize="22" Foreground="{StaticResource ForeColor}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button x:Name="AddButton" Style="{StaticResource BaseButtonStyle}" Content="Add" Grid.Row="4" Grid.Column="0" Margin="10" FontSize="20" Click="AddButton_Click"/>
        <Button Command="{Binding RemoveCardCommand}" Style="{StaticResource BaseButtonStyle}" Content="Remove" Grid.Row="4" Grid.Column="1" Margin="10" FontSize="20"/>
        <Button Command="{Binding ChangeCardCommand}" x:Name="ChangeButton" Style="{StaticResource BaseButtonStyle}" Content="Change" Grid.Row="4" Grid.Column="2" Margin="10" FontSize="20" Click="ChangeButton_Click"/>
        <Button Command="{Binding ImportDataCommand}" Style="{StaticResource BaseButtonStyle}" Content="Import" Grid.Row="4" Grid.Column="3" Margin="10" Width="100" FontSize="20"
            HorizontalAlignment="Left"/>
        <Button Command="{Binding ExportDataCommand}" Style="{StaticResource BaseButtonStyle}" Content="Export" Grid.Row="4" Grid.Column="3" Margin="10" Width="100" FontSize="20"
            HorizontalAlignment="Right"/>

        <Button Style="{StaticResource BaseButtonStyle}" Content="&lt;&lt;" Grid.Row="0" Grid.Column="0" Margin="10" FontSize="20" FontFamily="{StaticResource AdditiveFont}"
            HorizontalAlignment="Left" Width="50" Click="Button_Click"/>

        <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Grid.RowSpan="3" Margin="5">
            <StackPanel Margin="5">
                <Label Content="Card number: " FontSize="24" Foreground="{StaticResource ForeColor}" Padding="5" Margin="10 0"/>
                <DockPanel>
                    <Grid>
                        <TextBox Style="{StaticResource MainTextBox}" Text="{Binding SelectedNumber, StringFormat={}{0:0000 0000 0000 0000}}" FontSize="22" MinWidth="280" MaxWidth="280" Margin="10 10 0 10" Padding="5" VerticalAlignment="Center" IsReadOnly="True"/>
                        <Button Style="{StaticResource AnimatedButtonStyle}" Command="{Binding RevealDataCommand}" CommandParameter="Card number" Content="{Binding RevealImgNum}" BorderThickness="0" Width="30" Height="30" HorizontalAlignment="Right" Margin="10"/>
                    </Grid>
                    <Button Command="{Binding CopyDataCommand}" CommandParameter="Card number" Style="{StaticResource AnimatedCopyButtonStyle}" Content="{StaticResource CopyImage}" BorderThickness="0" HorizontalAlignment="Right" Click="CopyButton_Click"/>
                </DockPanel>
            </StackPanel>

            <DockPanel>
                <StackPanel Margin="5 5 0 5">
                    <Label Content="MM/YY: " FontSize="24" Foreground="{StaticResource ForeColor}" Padding="5" Margin="10 0"/>
                    <DockPanel>
                        <TextBox Style="{StaticResource MainTextBox}" Text="{Binding SelectedCard.MMYY, StringFormat={}{0:00/00}}" FontSize="22" MinWidth="115" MaxWidth="115"  Margin="10 10 0 10" Padding="5" VerticalAlignment="Center" IsReadOnly="True"/>
                        <Button Command="{Binding CopyDataCommand}" CommandParameter="MM/YY" Style="{StaticResource AnimatedCopyButtonStyle}" Content="{StaticResource CopyImage}" BorderThickness="0" HorizontalAlignment="Right" Margin="5" Click="CopyButton_Click"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel Margin="5 5 0 5">
                    <Label Content="CVV/CVC: " FontSize="24" Foreground="{StaticResource ForeColor}" Padding="5" Margin="5 0 10 0"/>
                    <DockPanel>
                        <Grid>
                            <TextBox Style="{StaticResource MainTextBox}" Text="{Binding SelectedCVV, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:000}}" FontSize="22" MinWidth="115" MaxWidth="115" Margin="5 10 0 10" Padding="5" VerticalAlignment="Center" IsReadOnly="True"/>
                            <Button Style="{StaticResource AnimatedButtonStyle}" Command="{Binding RevealDataCommand}" CommandParameter="CVV/CVC" Content="{Binding RevealImgCvv}" BorderThickness="0" Width="30" Height="30" HorizontalAlignment="Right" Margin="10"/>
                        </Grid>
                        <Button Command="{Binding CopyDataCommand}" CommandParameter="CVV/CVC" Style="{StaticResource AnimatedCopyButtonStyle}" Content="{StaticResource CopyImage}" BorderThickness="0" HorizontalAlignment="Right" Margin="5 5 7 5" Click="CopyButton_Click"/>
                    </DockPanel>
                </StackPanel>
            </DockPanel>
        </StackPanel>
        
        <Border x:Name="NotificationBorder" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="10"
            VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="30" Margin="10"
            Background="{StaticResource ForeColor}" Opacity="0">
            <Label Content="{Binding InfoText}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16"/>
        </Border>
    </Grid>
</Page>
