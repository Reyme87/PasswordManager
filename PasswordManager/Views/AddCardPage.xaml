<Page x:Class="PasswordManager.Views.AddCardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PasswordManager.Views"
      xmlns:vm="clr-namespace:PasswordManager.ViewModels"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="600" FontFamily="{StaticResource MainFont}"
      Title="AddCardPage">

    <Page.DataContext>
        <vm:CardsViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <ResourceDictionary Source="ResourceDictionary.xaml"/>
    </Page.Resources>

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2*"/>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition Width="0.2*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" FontSize="28" Foreground="{StaticResource ControlsColor}" Content="Add new payment method" 
           VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="3" Grid.ColumnSpan="2"
            CornerRadius="10" Background="{StaticResource ControlsColor}" BorderThickness="2" BorderBrush="{StaticResource ForeColor}"
            Margin="5">
            <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Grid.RowSpan="3" Margin="5">
                <StackPanel Margin="5">
                    <Label Content="Card number: " FontSize="24" Foreground="{StaticResource ForeColor}" Padding="5" Margin="10 0"/>
                    <TextBox Style="{StaticResource AddTextBox}" Text="{Binding CardNumberField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="22" Margin="10" Padding="5" VerticalAlignment="Center"/>
                    <!--<xctk:MaskedTextBox Mask="0000 0000 0000 0000" Style="{StaticResource AddTextBox}" Text="{Binding CardNumberField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="22" Margin="10" Padding="5" VerticalAlignment="Center"/>-->
                </StackPanel>

                <DockPanel>
                    <StackPanel Margin="5 5 0 5" HorizontalAlignment="Center">
                        <DockPanel>
                            <Label Content="MM: " FontSize="24" Foreground="{StaticResource ForeColor}" Padding="5" Margin="10 0"/>
                            <Label Content="YY: " FontSize="24" Foreground="{StaticResource ForeColor}" Padding="5" Margin="35 0" HorizontalAlignment="Right"/>
                        </DockPanel>
                        
                        <DockPanel>
                            <TextBox  Style="{StaticResource AddTextBox}" Text="{Binding MMField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:D2}}" Width="80" FontSize="22" Margin="10" Padding="5" VerticalAlignment="Center"/>
                            <Label Content="/" FontSize="40" Foreground="{StaticResource ForeColor}"/>
                            <TextBox  Style="{StaticResource AddTextBox}" Text="{Binding YYField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:D2}}" Width="80" FontSize="22" Margin="10" Padding="5" VerticalAlignment="Center"/>
                        </DockPanel>
                        
                    </StackPanel>

                    <StackPanel Margin="0 5 5 5" HorizontalAlignment="Right">
                        <Label Content="CVV/CVC: " FontSize="24" Foreground="{StaticResource ForeColor}" Padding="5" Margin="10 0"/>
                        <TextBox Style="{StaticResource AddTextBox}" Text="{Binding CVVField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:D3}}" Width="200" FontSize="22" Margin="10" Padding="5" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border x:Name="NotificationBorder" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" CornerRadius="10"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="30" Margin="15"
                Background="{StaticResource BackColor}" Opacity="0">
            <Label Content="Payment method has been saved" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource ForeColor}" FontSize="16"/>
        </Border>

        <Button x:Name="SaveButton" Command="{Binding AddCardCommand}" Style="{StaticResource BaseButtonStyle}" Content="Save" Grid.Row="4" Grid.Column="1"  Margin="10" FontSize="20" Click="SaveButton_Click"/>
        <Button x:Name="CancelButton" Command="{Binding CancelCommand}" Style="{StaticResource BaseButtonStyle}" Content="Cancel" Grid.Row="4" Grid.Column="2"  Margin="10" FontSize="20" Click="CancelButton_Click"/>
    </Grid>
</Page>
